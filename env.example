# Local PostgreSQL. Docker/Codespaces overrides this with the db service hostname.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Replaced automatically with a random value by scripts/bootstrap-env.mjs.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Development login requested for Midar. Change it before a public production deployment.
DEVELOPER_EMAIL=developer@midar.app
DEVELOPER_INITIAL_PASSWORD=900600

# Optional. Supabase also requires SUPABASE_URL; the publishable key alone cannot connect.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
