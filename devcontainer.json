{
  "name": "Midar Fullstack",
  "dockerComposeFile": "../compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "node scripts/bootstrap-env.mjs && npm install --no-audit --no-fund && npx drizzle-kit push",
  "postStartCommand": "npm run dev -- --hostname 0.0.0.0",
  "forwardPorts": [3000, 5432],
  "portsAttributes": {
    "3000": {
      "label": "Midar Platform",
      "onAutoForward": "openPreview"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}
